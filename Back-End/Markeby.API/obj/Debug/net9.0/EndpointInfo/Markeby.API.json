  "components": {
    "schemas": {
      "BoatStatus": {
        "enum": [
          "Active",
          "UnderMaintenance",
          "OutOfService"
        ],
        "type": "string"
      },
      "ChangePasswordCommand": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DtoCreateUser": {
        "required": [
          "confirmPassword",
          "email",
          "firstName",
          "lastName",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
