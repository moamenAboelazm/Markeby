        "enum": [
          "Egyptian",
          "Saudi",
          "Moroccan",
          "Tunisian",
          "Algerian",
          "Libyan",
          "Sudanese",
          "Another"
        ],
        "type": "string"
      },
      "UpdateProfileCommand": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "birthDate": {
            "type": "string",
